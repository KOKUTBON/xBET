{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 102,
  "title": "xBET - Microservices Platform Health & Ingestion",
  "tags": ["xbet", "infrastructure", "streaming", "http"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Active WebSocket Streaming Clients",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(xbet_active_websocket_connections)",
          "legendFormat": "Connected Users"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "Odds Feeds Ingestion Rate (Ticks/Sec)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (provider, sport) (rate(xbet_odds_update_throughput_total[1m]))",
          "legendFormat": "{{provider}} ({{sport}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 99th Percentile Latency (P99)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(xbet_http_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}} P99 (s)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Casino & Poker Live Concurrent Sessions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "xbet_casino_active_sessions",
          "legendFormat": "Casino: {{game_type}}"
        },
        {
          "expr": "xbet_poker_active_tables",
          "legendFormat": "Poker Tables: {{stakes}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Status 5xx / 4xx Error Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum by (service, status) (rate(xbet_http_requests_total{status=~\"[45]..\"}[1m]))",
          "legendFormat": "{{service}} - Status {{status}}"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
