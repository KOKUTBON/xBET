{
  "name": "@xbet/database",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared Prisma database client and connection management for xBET platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node --check --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types test/mysql_to_postgres_etl.test.ts",
    "db:generate": "npx --yes prisma generate",
    "db:migrate": "npx --yes prisma migrate deploy",
    "db:push": "npx --yes prisma db push",
    "db:studio": "npx --yes prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "typescript": "^5.4.0"
  }
}
