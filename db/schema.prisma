datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED

  @@map("user_status_enum")
}

enum UserRole {
  PLAYER
  AGENT
  SUPPORT
  RISK_MANAGER
  ADMINISTRATOR
  SUPER_ADMIN

  @@map("user_role_enum")
}

enum AccountType {
  PLAYER_MAIN
  PLAYER_BONUS
  HOUSE_MARGIN
  HOUSE_ESCROW
  PAYMENT_CLEARING
  AFFILIATE_COMMISSION

  @@map("account_type_enum")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  BET_CASHOUT
  CASINO_WAGER
  CASINO_PAYOUT
  CASINO_REFUND
  BONUS_GRANT
  BONUS_CONVERSION
  MANUAL_ADJUSTMENT
  AFFILIATE_PAYOUT

  @@map("transaction_type_enum")
}

enum TransactionDirection {
  DEBIT
  CREDIT

  @@map("transaction_direction_enum")
}

enum FixtureStatus {
  NOT_STARTED
  LIVE
  HALF_TIME
  EXTRA_TIME
  PENALTIES
  FINISHED
  POSTPONED
  CANCELLED
  INTERRUPTED
  ABANDONED

  @@map("fixture_status_enum")
}

enum MarketStatus {
  ACTIVE
  SUSPENDED
  SETTLED
  CANCELLED
  VOID

  @@map("market_status_enum")
}

enum SelectionStatus {
  ACTIVE
  SUSPENDED
  WON
  LOST
  HALF_WON
  HALF_LOST
  VOID
  CANCELLED

  @@map("selection_status_enum")
}

enum BetSlipType {
  SINGLE
  COMBI
  SYSTEM

  @@map("bet_slip_type_enum")
}

enum BetSlipStatus {
  PENDING
  ACCEPTED
  REJECTED
  WON
  LOST
  HALF_WON
  HALF_LOST
  CASHED_OUT
  VOID
  CANCELLED

  @@map("bet_slip_status_enum")
}

enum OddsFormat {
  DECIMAL
  FRACTIONAL
  AMERICAN
  HONG_KONG
  MALAY
  INDONESIAN

  @@map("odds_format_enum")
}

enum CasinoGameType {
  TABLE_GAME
  SLOT
  ROULETTE
  BLACKJACK
  BACCARAT
  POKER
  VIRTUAL_SPORTS
  LIVE_CASINO
  SCRATCH_CARD
  KENO
  BINGO

  @@map("casino_game_type_enum")
}

model Currency {
  code              String           @id @db.VarChar(3)
  name              String           @db.VarChar(50)
  symbol            String           @db.VarChar(8)
  exchangeRateToUsd Decimal          @default(1.0) @map("exchange_rate_to_usd") @db.Decimal(18, 8)
  decimals          Int              @default(2) @db.SmallInt
  isActive          Boolean          @default(true) @map("is_active")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  users             User[]
  ledgerAccounts    LedgerAccount[]
  transactions      Transaction[]
  betSlips          BetSlip[]
  casinoSessions    CasinoSession[]

  @@map("currencies")
}

model User {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username              String          @unique @db.VarChar(50)
  email                 String          @unique @db.VarChar(255)
  passwordHash          String          @map("password_hash") @db.VarChar(255)
  role                  UserRole        @default(PLAYER)
  status                UserStatus      @default(ACTIVE)
  preferredCurrencyCode String          @map("preferred_currency_code") @db.VarChar(3)
  preferredLanguage     String          @default("en") @map("preferred_language") @db.VarChar(10)
  oddsFormat            OddsFormat      @default(DECIMAL) @map("odds_format")
  referralUserId        String?         @map("referral_user_id") @db.Uuid
  twoFactorSecret       String?         @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled      Boolean         @default(false) @map("two_factor_enabled")
  registrationIp        String?         @map("registration_ip") @db.Inet
  lastLoginIp           String?         @map("last_login_ip") @db.Inet
  lastLoginAt           DateTime?       @map("last_login_at") @db.Timestamptz
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  preferredCurrency     Currency        @relation(fields: [preferredCurrencyCode], references: [code])
  referrer              User?           @relation("UserReferrals", fields: [referralUserId], references: [id])
  referrals             User[]          @relation("UserReferrals")
  profile               UserProfile?
  sessions              UserSession[]
  ledgerAccounts        LedgerAccount[]
  betSlips              BetSlip[]
  casinoSessions        CasinoSession[]
  riskLimits            RiskLimit[]
  auditLogs             AuditLog[]

  @@map("users")
}

model UserProfile {
  userId             String    @id @map("user_id") @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  dateOfBirth        DateTime  @map("date_of_birth") @db.Date
  phoneNumber        String?   @map("phone_number") @db.VarChar(30)
  countryCode        String    @map("country_code") @db.VarChar(2)
  city               String?   @db.VarChar(100)
  addressLine1       String?   @map("address_line_1") @db.VarChar(255)
  addressLine2       String?   @map("address_line_2") @db.VarChar(255)
  postalCode         String?   @map("postal_code") @db.VarChar(20)
  kycVerified        Boolean   @default(false) @map("kyc_verified")
  kycLevel           Int       @default(0) @map("kyc_level") @db.SmallInt
  dailyDepositLimit  Decimal?  @map("daily_deposit_limit") @db.Decimal(18, 2)
  dailyStakeLimit    Decimal?  @map("daily_stake_limit") @db.Decimal(18, 2)
  selfExclusionUntil DateTime? @map("self_exclusion_until") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash") @db.VarChar(255)
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent")
  isRevoked      Boolean  @default(false) @map("is_revoked")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model LedgerAccount {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?       @map("user_id") @db.Uuid
  accountType  AccountType   @map("account_type")
  currencyCode String        @map("currency_code") @db.VarChar(3)
  name         String        @db.VarChar(100)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user         User?         @relation(fields: [userId], references: [id])
  currency     Currency      @relation(fields: [currencyCode], references: [code])
  transactions Transaction[]

  @@unique([userId, accountType, currencyCode], name: "uq_user_account_currency")
  @@map("ledger_accounts")
}

model JournalEntry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryNumber     BigInt          @unique @default(autoincrement()) @map("entry_number")
  transactionType TransactionType @map("transaction_type")
  referenceId     String?         @map("reference_id") @db.VarChar(100)
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  description     String?
  metadata        Json?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  transactions    Transaction[]

  @@map("journal_entries")
}

model Transaction {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String               @map("journal_entry_id") @db.Uuid
  accountId      String               @map("account_id") @db.Uuid
  direction      TransactionDirection
  amount         Decimal              @db.Decimal(18, 4)
  currencyCode   String               @map("currency_code") @db.VarChar(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  journalEntry   JournalEntry         @relation(fields: [journalEntryId], references: [id])
  account        LedgerAccount        @relation(fields: [accountId], references: [id])
  currency       Currency             @relation(fields: [currencyCode], references: [code])

  @@map("transactions")
}

model Sport {
  id         Int        @id @default(autoincrement())
  externalId String?    @unique @map("external_id") @db.VarChar(100)
  slug       String     @unique @db.VarChar(100)
  name       String     @db.VarChar(100)
  iconName   String?    @map("icon_name") @db.VarChar(100)
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  i18nNames  Json?      @default("{}") @map("i18n_names")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  categories Category[]
  riskLimits RiskLimit[]

  @@map("sports")
}

model Category {
  id          Int          @id @default(autoincrement())
  externalId  String?      @unique @map("external_id") @db.VarChar(100)
  slug        String       @db.VarChar(100)
  name        String       @db.VarChar(100)
  countryCode String?      @map("country_code") @db.VarChar(3)
  flagUrl     String?      @map("flag_url") @db.VarChar(255)
  sportId     Int          @map("sport_id")
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sport       Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)
  tournaments Tournament[]

  @@unique([sportId, slug], name: "uq_category_sport_slug")
  @@map("categories")
}

model Tournament {
  id          Int         @id @default(autoincrement())
  externalId  String?     @unique @map("external_id") @db.VarChar(100)
  categoryId  Int         @map("category_id")
  slug        String      @db.VarChar(150)
  name        String      @db.VarChar(150)
  isActive    Boolean     @default(true) @map("is_active")
  isFeatured  Boolean     @default(false) @map("is_featured")
  minStake    Decimal?    @default(0.10) @map("min_stake") @db.Decimal(18, 2)
  maxStake    Decimal?    @default(5000.00) @map("max_stake") @db.Decimal(18, 2)
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  fixtures    Fixture[]
  riskLimits  RiskLimit[]

  @@unique([categoryId, slug], name: "uq_tournament_category_slug")
  @@map("tournaments")
}

model Fixture {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId     String?       @unique @map("external_id") @db.VarChar(100)
  tournamentId   Int           @map("tournament_id")
  homeTeam       String        @map("home_team") @db.VarChar(150)
  awayTeam       String        @map("away_team") @db.VarChar(150)
  homeTeamId     String?       @map("home_team_id") @db.VarChar(100)
  awayTeamId     String?       @map("away_team_id") @db.VarChar(100)
  startTime      DateTime      @map("start_time") @db.Timestamptz
  status         FixtureStatus @default(NOT_STARTED)
  isInPlay       Boolean       @default(false) @map("is_in_play")
  currentScore   Json?         @default("{\"home\": 0, \"away\": 0}") @map("current_score")
  periodScores   Json?         @default("[]") @map("period_scores")
  matchClock     String?       @map("match_clock") @db.VarChar(30)
  feedProvider   String        @default("OddsFeed") @map("feed_provider") @db.VarChar(50)
  lastFeedUpdate DateTime?     @map("last_feed_update") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tournament     Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  markets        Market[]
  betLegs        BetLeg[]

  @@map("fixtures")
}

model Market {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId String?      @map("external_id") @db.VarChar(100)
  fixtureId  String       @map("fixture_id") @db.Uuid
  marketType String       @map("market_type") @db.VarChar(100)
  name       String       @db.VarChar(150)
  line       String?      @db.VarChar(50)
  status     MarketStatus @default(ACTIVE)
  isInPlay   Boolean      @default(false) @map("is_in_play")
  sortOrder  Int          @default(0) @map("sort_order")
  settledAt  DateTime?    @map("settled_at") @db.Timestamptz
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fixture    Fixture      @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  selections Selection[]
  betLegs    BetLeg[]

  @@unique([fixtureId, marketType, line], name: "uq_fixture_market_line")
  @@map("markets")
}

model Selection {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId   String?         @map("external_id") @db.VarChar(100)
  marketId     String          @map("market_id") @db.Uuid
  name         String          @db.VarChar(100)
  odds         Decimal         @db.Decimal(8, 4)
  previousOdds Decimal?        @map("previous_odds") @db.Decimal(8, 4)
  status       SelectionStatus @default(ACTIVE)
  probability  Decimal?        @db.Decimal(5, 4)
  sortOrder    Int             @default(0) @map("sort_order")
  settledAt    DateTime?       @map("settled_at") @db.Timestamptz
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  market       Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)
  betLegs      BetLeg[]

  @@map("selections")
}

model BetSlip {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slipNumber      String        @unique @map("slip_number") @db.VarChar(30)
  userId          String        @map("user_id") @db.Uuid
  betType         BetSlipType   @default(SINGLE) @map("bet_type")
  status          BetSlipStatus @default(PENDING)
  currencyCode    String        @map("currency_code") @db.VarChar(3)
  stakeAmount     Decimal       @map("stake_amount") @db.Decimal(18, 4)
  totalOdds       Decimal       @map("total_odds") @db.Decimal(12, 4)
  potentialPayout Decimal       @map("potential_payout") @db.Decimal(18, 4)
  actualPayout    Decimal?      @default(0) @map("actual_payout") @db.Decimal(18, 4)
  cashoutAmount   Decimal?      @map("cashout_amount") @db.Decimal(18, 4)
  isInPlay        Boolean       @default(false) @map("is_in_play")
  placedIp        String?       @map("placed_ip") @db.Inet
  settledAt       DateTime?     @map("settled_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User          @relation(fields: [userId], references: [id])
  currency        Currency      @relation(fields: [currencyCode], references: [code])
  legs            BetLeg[]

  @@map("bet_slips")
}

model BetLeg {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  betSlipId             String          @map("bet_slip_id") @db.Uuid
  selectionId           String          @map("selection_id") @db.Uuid
  fixtureId             String          @map("fixture_id") @db.Uuid
  marketId              String          @map("market_id") @db.Uuid
  lockedOdds            Decimal         @map("locked_odds") @db.Decimal(8, 4)
  status                SelectionStatus @default(ACTIVE)
  fixtureNameSnapshot   String          @map("fixture_name_snapshot") @db.VarChar(255)
  marketNameSnapshot    String          @map("market_name_snapshot") @db.VarChar(150)
  selectionNameSnapshot String          @map("selection_name_snapshot") @db.VarChar(100)
  settledAt             DateTime?       @map("settled_at") @db.Timestamptz
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz

  betSlip               BetSlip         @relation(fields: [betSlipId], references: [id], onDelete: Cascade)
  selection             Selection       @relation(fields: [selectionId], references: [id])
  fixture               Fixture         @relation(fields: [fixtureId], references: [id])
  market                Market          @relation(fields: [marketId], references: [id])

  @@map("bet_legs")
}

model CasinoProvider {
  id          Int          @id @default(autoincrement())
  code        String       @unique @db.VarChar(50)
  name        String       @db.VarChar(100)
  isActive    Boolean      @default(true) @map("is_active")
  apiEndpoint String?      @map("api_endpoint") @db.VarChar(255)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  games       CasinoGame[]

  @@map("casino_providers")
}

model CasinoGame {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId    Int             @map("provider_id")
  gameCode      String          @map("game_code") @db.VarChar(100)
  slug          String          @unique @db.VarChar(100)
  title         String          @db.VarChar(150)
  category      CasinoGameType
  thumbnailUrl  String?         @map("thumbnail_url") @db.VarChar(255)
  bannerUrl     String?         @map("banner_url") @db.VarChar(255)
  rtpPercentage Decimal         @default(96.00) @map("rtp_percentage") @db.Decimal(5, 2)
  minBet        Decimal         @default(0.10) @map("min_bet") @db.Decimal(18, 2)
  maxBet        Decimal         @default(1000.00) @map("max_bet") @db.Decimal(18, 2)
  hasDemo       Boolean         @default(true) @map("has_demo")
  isActive      Boolean         @default(true) @map("is_active")
  isFeatured    Boolean         @default(false) @map("is_featured")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  provider      CasinoProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sessions      CasinoSession[]
  virtualEvents VirtualEvent[]

  @@unique([providerId, gameCode], name: "uq_provider_game_code")
  @@map("casino_games")
}

model CasinoSession {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  gameId        String        @map("game_id") @db.Uuid
  sessionToken  String        @unique @map("session_token") @db.VarChar(255)
  currencyCode  String        @map("currency_code") @db.VarChar(3)
  ipAddress     String?       @map("ip_address") @db.Inet
  isActive      Boolean       @default(true) @map("is_active")
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  game          CasinoGame    @relation(fields: [gameId], references: [id])
  currency      Currency      @relation(fields: [currencyCode], references: [code])
  rounds        CasinoRound[]

  @@map("casino_sessions")
}

model CasinoRound {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId      String        @map("session_id") @db.Uuid
  roundNumber    String        @map("round_number") @db.VarChar(100)
  serverSeedHash String?       @map("server_seed_hash") @db.VarChar(255)
  serverSeed     String?       @map("server_seed") @db.VarChar(255)
  clientSeed     String?       @map("client_seed") @db.VarChar(255)
  nonce          BigInt?       @default(0)
  totalWager     Decimal       @default(0) @map("total_wager") @db.Decimal(18, 4)
  totalPayout    Decimal       @default(0) @map("total_payout") @db.Decimal(18, 4)
  gameState      Json?         @default("{}") @map("game_state")
  isCompleted    Boolean       @default(false) @map("is_completed")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz

  session        CasinoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, roundNumber], name: "uq_session_round")
  @@map("casino_rounds")
}

model VirtualEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gameId          String        @map("game_id") @db.Uuid
  eventNumber     BigInt        @map("event_number")
  name            String        @db.VarChar(150)
  startTime       DateTime      @map("start_time") @db.Timestamptz
  durationSeconds Int           @default(180) @map("duration_seconds")
  status          FixtureStatus @default(NOT_STARTED)
  resultData      Json?         @default("{}") @map("result_data")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  game            CasinoGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("virtual_events")
}

model RiskLimit {
  id                 Int         @id @default(autoincrement())
  sportId            Int?        @map("sport_id")
  tournamentId       Int?        @map("tournament_id")
  userId             String?     @map("user_id") @db.Uuid
  maxStakePerBet     Decimal?    @map("max_stake_per_bet") @db.Decimal(18, 2)
  maxPayoutPerBet    Decimal?    @map("max_payout_per_bet") @db.Decimal(18, 2)
  maxMarketLiability Decimal?    @map("max_market_liability") @db.Decimal(18, 2)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  sport              Sport?      @relation(fields: [sportId], references: [id], onDelete: Cascade)
  tournament         Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user               User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("risk_limits")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  targetEntity String   @map("target_entity") @db.VarChar(100)
  targetId     String   @map("target_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.Inet
  details      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  actorUser    User?    @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
