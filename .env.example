# ==============================================================================
# xBET Platform - Environment Configuration Template
# Provide your local configuration settings below. Never commit real credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Microservices
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
ODDS_ENGINE_URL=http://127.0.0.1:4000
JWT_SECRET=replace_with_secure_random_256_bit_jwt_secret
ENABLE_SIMULATOR=true
XBET_PILOT_MODE=true
# Set to true only when backends are reachable solely through the gateway/web proxy;
# it makes auth rate limiting use the proxy-supplied X-Real-IP client address.
XBET_TRUST_PROXY=false
# Generate once with: openssl rand -hex 32; retain securely for seed decryption.
RNG_SEED_KEY=

# ------------------------------------------------------------------------------
# 2. Database & High-Throughput Caching (PostgreSQL 16 & Redis 7)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://xbet:xbet_dev@localhost:5432/xbet?schema=public
# On a fresh database run npm run db:migrate:points (migrations 001–005).
# See docs/points-pilot-runbook.md before upgrading an existing database.
# XBET_ALLOW_VOLATILE_BETS=true enables memory bets for isolated non-production demos.
# XBET_ALLOW_VOLATILE_CASINO=true enables memory casino rounds for isolated non-production demos.
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Initial Administrator Bootstrap (Optional, minimum 16 characters)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Sports & Live In-Play Odds Feeds (TheOddsAPI, EnetPulse, OddService)
# ------------------------------------------------------------------------------
# TheOddsAPI (Free tier key from https://the-odds-api.com; leave blank for local simulator)
THE_ODDS_API_KEY=
LIVE_FEED_SPORTS=soccer_epl,soccer_uefa_champs_league,basketball_nba
LIVE_FEED_REGIONS=uk,eu
LIVE_FEED_MARKETS=h2h,totals
LIVE_FEED_ODDS_INTERVAL_MS=60000
LIVE_FEED_SCORES_INTERVAL_MS=30000

# EnetPulse Feed Adapter (Optional)
ENETPULSE_URL=wss://push.enetpulse.com/feed
ENETPULSE_API_KEY=your_enetpulse_api_key_here
ENETPULSE_USERNAME=your_enetpulse_username
ENETPULSE_PASSWORD=your_enetpulse_password

# OddService Feed Adapter (Optional)
ODDSERVICE_URL=wss://push.oddservice.com/feed
ODDSERVICE_API_KEY=your_oddservice_api_key_here

# Betclick XML Feed Adapter (Optional)
BETCLICK_XML_URL=http://xml.cdn.betclic.com/odds_en.xml
FEED_IMPORT_PREMATCH=1
FEED_IMPORT_LIVE=1
FEED_UPDATE_ODDS=1

# Bookmaker margin percentage overround (e.g. 106.5 = 6.5% house margin)
ODDS_MARGIN_OVERROUND=106.5

# ------------------------------------------------------------------------------
# 5. Casino & Live Dealer Studios (Example aggregator placeholders)
# ------------------------------------------------------------------------------
LIVE_CASINO_STUDIO_ONE_SECRET=your_studio_one_secret_key
LIVE_CASINO_STUDIO_TWO_SECRET=your_studio_two_secret_key
LIVE_CASINO_STUDIO_THREE_SECRET=your_studio_three_secret_key

# ------------------------------------------------------------------------------
# 6. Payment Gateway Drivers (Demonstration & Sandbox Integration)
# ------------------------------------------------------------------------------
# Stripe Credit/Debit Cards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# CoinPayments Merchant
COINPAYMENTS_MERCHANT_ID=
COINPAYMENTS_IPN_SECRET=
COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=

# Blockchain / Bitcoin
BLOCKCHAIN_SUBMIT_URL=
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_TEST=true
BLOCKCHAIN_ROOT=https://blockchain.info/
BLOCKCHAIN_SECRET=
BLOCKCHAIN_XPUB=

# Skrill
SKRILL_MERCHANT_EMAIL=payments@example.com
SKRILL_SECRET_WORD=your_skrill_secret_word

# NovinPal Gateway
NOVINPAL_API_KEY=your_novinpal_api_key

# ------------------------------------------------------------------------------
# 7. Email Settings for Notifications & Verifications
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=support@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=support@example.com
EMAIL_USE_SSL=true

# ------------------------------------------------------------------------------
# 8. Background Cron Intervals
# ------------------------------------------------------------------------------
CRON_LIVE_INTERVAL_SECONDS=15
CRON_PREMATCH_INTERVAL_MINUTES=30
